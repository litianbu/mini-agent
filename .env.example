# ─────────────────────────────────────────────
# 复制一份：cp .env.example .env
# 什么都不填也能跑 —— 后端会自动进入 MOCK 模式（本地假数据）
#
# 这个文件在**仓库根目录**：后端（apps/backend）会读它。
# 它已被 .gitignore 忽略，密钥不会进版本库。
# ─────────────────────────────────────────────

# 填了就走真模型（DeepSeek 最便宜：https://platform.deepseek.com）
DEEPSEEK_API_KEY=

# 想换服务商就改这两行（必须是 OpenAI 兼容协议）
# LLM_BASE_URL=https://api.deepseek.com
# LLM_MODEL=deepseek-flash

# 思考模式：1 打开（会先吐思考过程再给答案），默认关
# THINKING=0

# 强制走假模型，即使有 key（调试管道用）
# MOCK=1

# 后端端口（前端的 /api 会代理到这里）
# PORT=8787

# ── 数据库 ─────────────────────────────────────────
# 只需要填密码。地址/端口/用户/库名都在 core/config.py 里，
# 想换库（Postgres/SQLite）改那里的 db_driver 一行即可。
#
# 不填 = 关闭数据库功能，agent 照常跑（会话不会保存）。
DB_PASSWORD=

# 或者用完整 URL 覆盖上面所有设置（CI / 云上 / SQLite 文件库）：
# DATABASE_URL=mysql+aiomysql://user:pass@127.0.0.1:3306/mini_agent?charset=utf8mb4
# DATABASE_URL=sqlite+aiosqlite:///./data/app.db
#
# 配好之后建表：
#   cd apps/backend && uv run python -m mini_agent.db.database
